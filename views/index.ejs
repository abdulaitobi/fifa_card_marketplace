<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>FIFA Card Inventory</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">
    <script src="/script.js" defer></script>
</head>
<body class="bg-success bg-gradient">
    <main>
        <div class="main-content">
            <h1><a href="/">FIFA Card Marketplace</a></h1>
            <details id="player-form" <%= formOpen ? "open" : "" %>>
                <summary class="btn btn-dark"><%= editing ? "Edit Player" : "Add Player" %></summary>
                <form class="bg-black bg-gradient p-3 rounded mt-2"
                      action="<%= editing ? '/players/' + editing.id + '/edit' : '/addPlayer' %>" method="post">
                    <input type="hidden" name="search" value="<%= search %>">
                    <% if (error) { %><p class="alert alert-danger" role="alert"><%= error %></p><% } %>
                    <label for="playerName" class="form-label">Player Name</label>
                    <input id="playerName" name="playerName" type="text" class="form-control mb-2"
                           maxlength="255" value="<%= values.playerName ?? '' %>" required>
                    <label for="nationality" class="form-label">Nationality</label>
                    <select id="nationality" name="nationality" class="form-select mb-2" required>
                        <option value="">Select a country</option>
                        <% for (const country of countries) { %>
                            <option value="<%= country.code %>" <%= values.nationality === country.code ? "selected" : "" %>><%= country.name %></option>
                        <% } %>
                    </select>
                    <label for="price" class="form-label">Price</label>
                    <input id="price" name="price" type="number" class="form-control" min="0"
                           max="999999999999.99" step="0.01" value="<%= values.price ?? '' %>" required>
                    <button type="submit" class="btn btn-primary mt-2">Save</button>
                    <a href="<%= inventoryUrl %>" class="btn btn-secondary mt-2">Cancel</a>
                </form>
            </details>
            <form class="inventory-search d-flex gap-2 flex-wrap" role="search" action="/searchPlayers" method="get">
                <input name="search-query" class="form-control" type="search" placeholder="Search by player name"
                       aria-label="Player name" value="<%= search %>">
                <button class="btn btn-dark" type="submit">Search</button>
                <% if (search) { %><a class="btn btn-outline-light" href="/">Clear</a><% } %>
            </form>
        </div>
        <div id="card-display">
            <% if (!players.length) { %>
                <p class="empty-inventory"><%= search ? "No players match your search." : "No cards yet. Add a player to get started." %></p>
            <% } %>
            <% for (const player of players) { %>
                <% const code = player.countryname?.toUpperCase(); const country = countryNames.get(code); %>
                <article class="player-card">
                    <% if (country) { %>
                        <img class="player-flag" src="https://flagcdn.com/48x36/<%= code.toLowerCase() %>.png" alt="">
                    <% } %>
                    <h2 class="h4"><%= player.playername %></h2>
                    <p class="player-country"><%= country || player.countryname %></p>
                    <p class="player-price"><%= player.price == null ? 'Price unavailable' : '$' + player.price %></p>
                    <div class="player-card-actions mt-2">
                        <a class="btn btn-warning" href="/players/<%= player.id %>/edit<%= search ? '?' + new URLSearchParams({ 'search-query': search }) : '' %>">Edit</a>
                        <form method="post" action="/players/<%= player.id %>/delete" data-confirm-delete>
                            <input type="hidden" name="search" value="<%= search %>">
                            <button class="btn btn-danger" type="submit">Delete</button>
                        </form>
                    </div>
                </article>
            <% } %>
        </div>
    </main>
</body>
</html>
